**/xcshareddata/WorkspaceSettings.xcsettings

# SwiftPM / SourceKit-LSP build output (e.g. local Swift packages opened in an IDE)
.build/
.swiftpm/

# Local Swift packages are libraries: their lock is owned by the consumer
kotlin-library/FirebaseAIBridge/Package.resolved

# SwiftPM import (KGP): commit only the lock file; the synthetic package is regenerated
# on every build and the checkout is ignored by the plugin's own .gitignore
.swiftpm-locks/*/swiftImport/*
!.swiftpm-locks/*/swiftImport/Package.resolved
